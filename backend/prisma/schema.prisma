
generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Un compte utilisateur
model User {
  id         String      @id @default(cuid()) // identifiant unique généré automatiquement
  email      String      @unique              // @unique : deux comptes ne peuvent pas avoir le même email
  motDePasse String                           // jamais en clair : c'est le hash bcrypt
  depenses   Depense[]                        
  categories Categorie[]                      
}

// Une ligne du budget : un revenu OU une dépense
model Depense {
  id          String     @id @default(cuid())
  titre       String
  montant     Float
  type        String     @default("depense")  
  date        DateTime   @default(now())      
  categorieId String?                         // le "?" veut dire facultatif
  categorie   Categorie? @relation(fields: [categorieId], references: [id])
  userId      String                          
  user        User       @relation(fields: [userId], references: [id])
  serieId     String?                         // même valeur pour toutes les lignes d'une série mensuelle

  @@index([userId, date])                     // accélère la recherche "mes lignes d'un mois"
}


model Categorie {
  id       String    @id @default(cuid())
  nom      String
  couleur  String                              
  depenses Depense[]
  userId   String
  user     User      @relation(fields: [userId], references: [id])
}