# Copie ce fichier en ".env" et remplis les valeurs. Ne committe jamais ".env".

# Adresse de la base PostgreSQL
DATABASE_URL="postgresql://UTILISATEUR:MOTDEPASSE@localhost:5432/depenses"

# Chaîne aléatoire pour signer les connexions. Génère-la avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# "production" uniquement sur le serveur hébergé
# NODE_ENV=production